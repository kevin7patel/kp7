# Notion internal integration token (read-only capabilities are enough).
# Create at https://www.notion.so/profile/integrations and share your pages with it.
NOTION_TOKEN=
# 32-byte base64url key used to encrypt the published dashboard payload.
# Generate one in the app (Settings → Generate key) or: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DASHBOARD_KEY=
