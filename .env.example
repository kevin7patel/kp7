# Server-only configuration for the sync pipeline (never bundled into the app).
# Copy to an ignored .env (or .env.local) and set secrets privately. Never paste them in chat.

# Notion internal integration token — Read content capability only.
NOTION_TOKEN=
# 32-byte base64url key that encrypts the published payload (Settings → Generate key).
DASHBOARD_KEY=

# Non-secret identifiers (defaults live in config/notion.config.ts; these override them).
NOTION_TASKS_DATA_SOURCE_ID=ed47cf5c-9013-48bd-8c76-d3fd8806caff
NOTION_PROJECTS_DATA_SOURCE_ID=a862fc2e-e045-45a0-972b-6592df011baa
NOTION_FITNESS_PAGE_ID=3ed38b58-7685-817c-bbb1-d66caef90823
DASHBOARD_TIMEZONE=America/Chicago
DASHBOARD_DATA_DIR=.data
